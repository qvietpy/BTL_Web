<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Quản Lí Phòng Trọ</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/owner.css"> 
</head>
<body>

    <div class="d-flex" id="wrapper">

        <div class="bg-dark border-right" id="sidebar-wrapper">
            <div class="sidebar-heading text-light text-center py-4 fs-4 fw-bold">
                <i class="bi bi-house-lock-fill me-2"></i>Quản Lí Trọ
            </div>
            <div class="list-group list-group-flush">
                <a asp-area="Owner" asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-speedometer2 me-2"></i>Tổng quan
                </a>
                <a asp-area="Owner" asp-controller="Room" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-door-open-fill me-2"></i>Quản lý Phòng
                </a>
                <a asp-area="Owner" asp-controller="Bill" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-receipt-cutoff me-2"></i>Quản lý Hóa Đơn
                </a>
                <a asp-area="Owner" asp-controller="Contracts" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-file-earmark-text me-2"></i>Hợp đồng
                </a>
                <a asp-area="Owner" asp-controller="Booking" asp-action="Requests" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-inbox me-2"></i>Yêu cầu thuê
                </a>
                <a asp-area="Owner" asp-controller="Notice" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-bell me-2"></i>Thông báo
                </a>
                <a asp-area="Owner" asp-controller="Report" asp-action="Index" class="list-group-item list-group-item-action list-group-item-dark p-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>Báo cáo sự cố
                </a>
                </div>
        </div>

        <div id="page-content-wrapper">

            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm">
                <div class="container-fluid">
                    <button class="btn btn-primary" id="menu-toggle"><i class="bi bi-list"></i></button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> 
                                    Xin chào, @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#">Thông tin cá nhân</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                                            Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <main role="main" class="container-fluid p-4">
                
                @RenderBody()

            </main>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="~/js/site.js"></script>
    <script src="~/js/owner.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>