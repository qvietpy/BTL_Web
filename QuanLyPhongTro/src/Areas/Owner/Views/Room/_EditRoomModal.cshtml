<div class="modal fade" id="editRoomModal" tabindex="-1" aria-labelledby="editRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Owner" asp-controller="Room" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editRoomModalLabel">Chỉnh sửa phòng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit_roomId" name="Id" />
                    <div class="mb-3">
                        <label class="form-label">Tên phòng</label>
                        <input type="text" id="edit_roomName" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" id="edit_roomAddress" name="Address" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Diện tích (m²)</label>
                            <input type="number" step="0.01" id="edit_roomArea" name="Area" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Giá (VND)</label>
                            <input type="number" step="0.01" id="edit_roomPrice" name="Price" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select id="edit_roomStatus" name="Status" class="form-select">
                            <option value="Empty">Trống</option>
                            <option value="Rented">Đã thuê</option>
                            <option value="Maintenance">Sửa chữa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        <textarea id="edit_roomDescription" name="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>