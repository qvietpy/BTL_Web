@model IEnumerable<QuanLyPhongTro.Models.Report>
@{
    ViewData["Title"] = "Báo cáo sự cố";
    Layout = "_LayoutOwner";
}
<h3 class="mb-3"><i class="fas fa-exclamation-triangle me-2"></i>Báo cáo sự cố</h3>
@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light"><tr><th>Phòng</th><th>Người báo cáo</th><th>Tiêu đề</th><th>Ngày</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody>
      @if(Model!=null && Model.Any()){
        @foreach(var r in Model){
          <tr>
            <td>@r.IdRoomNavigation?.Name</td>
            <td>@(r.IdReporterNavigation?.IdDetailNavigation?.Name ?? r.IdReporterNavigation?.Username)</td>
            <td>@r.Title</td>
            <td>@r.DateCreated?.ToString("dd/MM/yyyy HH:mm")</td>
            <td>
              @if(r.Status=="Pending"){<span class="badge bg-warning text-dark">Chờ xử lý</span>}
              else if(r.Status=="InProgress"){<span class="badge bg-info text-dark">Đang xử lý</span>}
              else if(r.Status=="Resolved"){<span class="badge bg-success">Hoàn t?t</span>}
              else {<span class="badge bg-secondary">@r.Status</span>}
            </td>
            <td class="text-end">
              @if(r.Status=="Pending"){
                <form asp-area="Owner" asp-controller="Report" asp-action="MarkInProgress" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-primary">Xử lý</button></form>
              }
              @if(r.Status=="InProgress" || r.Status=="Pending"){
                <form asp-area="Owner" asp-controller="Report" asp-action="MarkResolved" method="post" class="d-inline ms-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><button class="btn btn-sm btn-success">Hoàn tất</button></form>
              }
            </td>
          </tr>
        }
      } else {<tr><td colspan="6" class="text-center text-muted">Không có báo cáo.</td></tr>}
      </tbody>
    </table>
  </div>
</div>
