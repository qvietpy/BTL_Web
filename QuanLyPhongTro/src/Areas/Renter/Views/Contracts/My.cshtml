@model IEnumerable<QuanLyPhongTro.src.Models.ViewModels.RenterContractViewModel>
@{
    ViewData["Title"] = "Hợp đồng của tôi";
    // Nếu bạn đã có Layout chung thì để dòng dưới, nếu chưa thì để null
    Layout = "_LayoutRenter"; 
}

<style>
    .contract-card {
        background: white;
        border-radius: 15px;
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%; /* Để các card bằng nhau */
    }
    .contract-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    /* Màu sắc trạng thái */
    .bg-pending { background-color: #fff3cd; color: #856404; }
    .bg-active { background-color: #d4edda; color: #155724; }
    .bg-expired { background-color: #f8d7da; color: #721c24; }
    .bg-cancelled { background-color: #e2e3e5; color: #383d41; }
    
    .info-label { font-size: 0.85rem; color: #6c757d; }
    .info-value { font-weight: 600; color: #333; }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="fas fa-file-contract text-primary me-2"></i>Hợp đồng của tôi</h3>
        <a class="nav-link" asp-area="Renter" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-search me-1"></i>Tìm phòng mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm">
            <div class="mb-3">
                <i class="fas fa-folder-open fa-3x text-muted"></i>
            </div>
            <h5 class="text-muted">Bạn chưa có hợp đồng nào</h5>
            <p class="text-secondary mb-4">Hãy tìm kiếm phòng trọ ưng ý và gửi yêu cầu thuê ngay.</p>
            <a asp-area="" asp-controller="Renter" asp-action="Rooms" class="btn btn-primary px-4">
                Tìm phòng ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                // --- NGHIỆP VỤ TÍNH TOÁN ---
                var statusClass = item.Status switch
                {
                    "Pending" => "bg-pending",
                    "Active" => "bg-active",
                    "Expired" => "bg-expired",
                    _ => "bg-cancelled"
                };

                var statusText = item.Status switch
                {
                    "Pending" => "Đang chờ duyệt",
                    "Active" => "Đang hiệu lực",
                    "Expired" => "Đã hết hạn",
                    _ => "Đã hủy"
                };

                // Tính toán thời gian
                var totalDays = (item.EndDate - item.StartDate).TotalDays;
                var remainingDays = (item.EndDate - DateTime.Now).TotalDays;
                var durationMonths = ((item.EndDate.Year - item.StartDate.Year) * 12) + item.EndDate.Month - item.StartDate.Month;
                
                // Tính % tiến độ (chỉ hiện khi Active)
                var progress = 0;
                if (item.Status == "Active" && totalDays > 0)
                {
                    progress = Math.Max(0, Math.Min(100, (int)(((totalDays - remainingDays) / totalDays) * 100)));
                }
                // ---------------------------

                <div class="col-md-6 col-lg-6">
                    <div class="card contract-card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1 text-primary fw-bold">@item.RoomName</h5>
                                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i>@item.RoomAddress</small>
                                </div>
                                <span class="status-badge @statusClass">
                                    @statusText
                                </span>
                            </div>

                            <hr class="my-2 opacity-25">

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <div class="info-label">Ngày bắt đầu</div>
                                    <div class="info-value">@item.StartDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6">
                                    <div class="info-label">Ngày kết thúc</div>
                                    <div class="info-value">@item.EndDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6">
                                    <div class="info-label">Giá thuê</div>
                                    <div class="info-value text-primary">@item.Deposit.ToString("N0") đ/tháng</div>
                                </div>
                                <div class="col-6">
                                    <div class="info-label">Tiền cọc</div>
                                    <div class="info-value text-danger">@item.Deposit.ToString("N0") đ</div>
                                </div>
                            </div>

                            @if (item.Status == "Active")
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">Thời hạn (@durationMonths tháng)</span>
                                        <span class="fw-bold text-success">Còn @Math.Max(0, Math.Round(remainingDays)) ngày</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @progress%"></div>
                                    </div>
                                </div>
                            }

                            <div class="bg-light p-2 rounded mb-3 d-flex align-items-center">
                                <div class="flex-shrink-0 bg-white rounded-circle p-2 text-primary shadow-sm">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="ms-2">
                                    <div class="small fw-bold">@item.OwnerName</div>
                                    <div class="small text-muted">@item.OwnerPhone</div>
                                </div>
                            </div>

                            <div class="mt-auto row g-2">
                                @if (item.Status == "Active")
                                {
                                    <div class="col-6">
                                        <a class="nav-link" asp-area="Renter" asp-controller="Dashboard" asp-action="Index" asp-route-id="@item.Id" 
                                           class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fas fa-eye me-1"></i>Chi tiết
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-area="Renter" asp-controller="Dashboard" asp-action="SendNotice" class="btn btn-outline-warning btn-sm w-100">
                                            <i class="fas fa-exclamation-triangle me-1"></i>Báo cáo
                                        </a>
                                    </div>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <div class="col-12">
                                        <button class="btn btn-secondary btn-sm w-100" disabled>
                                            <i class="fas fa-clock me-1"></i>Đang chờ chủ trọ duyệt
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-12">
                                        <a asp-area="" asp-controller="Renter" asp-action="ContractDetail" asp-route-id="@item.Id" 
                                           class="btn btn-outline-secondary btn-sm w-100">
                                            <i class="fas fa-history me-1"></i>Xem lại hợp đồng
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>