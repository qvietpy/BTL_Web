@model QuanLyPhongTro.src.Models.ViewModels.RenterDashboardViewModel
@{
    ViewData["Title"] = "B?ng ?i?u khi?n";
    Layout = "_LayoutRenter";
    DateTime? startDt = Model.ContractStart.HasValue ? Model.ContractStart.Value.ToDateTime(TimeOnly.MinValue) : null;
    DateTime? endDt = Model.ContractEnd.HasValue ? Model.ContractEnd.Value.ToDateTime(TimeOnly.MinValue) : null;
    var totalDays = (endDt.HasValue && startDt.HasValue) ? (endDt.Value - startDt.Value).TotalDays : 0;
    var leftDays = endDt.HasValue ? (endDt.Value - DateTime.Now).TotalDays : 0;
    var progress = totalDays>0 ? Math.Max(0, Math.Min(100, (int)(((totalDays - leftDays)/totalDays)*100))) : 0;
}
<h3 class="mb-4"><i class="fas fa-home me-2"></i>Phòng c?a tôi</h3>
@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}
<div class="row g-3 mb-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm h-100"><div class="card-body"><h6 class="text-muted mb-1">Ti?n c?n tr?</h6><h4 class="text-danger mb-0">@Model.OutstandingAmount.ToString("N0") ?</h4></div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm h-100"><div class="card-body"><h6 class="text-muted mb-1">??t c?c</h6><h4 class="mb-0">@Model.Deposit?.ToString("N0") ?</h4></div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm h-100"><div class="card-body"><h6 class="text-muted mb-1">Còn l?i h?p ??ng</h6><h4 class="mb-0">@(leftDays<0?0:Math.Round(leftDays)) ngày</h4></div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card shadow-sm h-100"><div class="card-body"><h6 class="text-muted mb-1">Ti?n ?? h?p ??ng</h6><div class="progress" style="height:22px"><div class="progress-bar" role="progressbar" style="width:@progress%">@progress%</div></div></div></div>
  </div>
</div>
<div class="row">
  <div class="col-lg-6">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title d-flex justify-content-between align-items-center">@Model.RoomName <span class="badge bg-info">@Model.RoomStatus</span></h5>
        <p class="text-muted mb-2"><i class="fas fa-map-marker-alt me-1 text-danger"></i>@Model.RoomAddress</p>
        <div class="row small mb-2">
          <div class="col-6">Di?n tích: <strong>@Model.RoomArea m²</strong></div>
          <div class="col-6">Giá: <strong>@Model.RoomPrice?.ToString("N0") ? / tháng</strong></div>
        </div>
        <div class="row small mb-2">
          <div class="col-6">B?t ??u: <strong>@Model.ContractStart?.ToString("dd/MM/yyyy")</strong></div>
          <div class="col-6">K?t thúc: <strong>@Model.ContractEnd?.ToString("dd/MM/yyyy")</strong></div>
        </div>
        <p class="small mb-1">Tr?ng thái h?p ??ng: <span class="badge bg-success">@Model.ContractStatus</span></p>
        <p class="small mb-2">??t c?c: <strong>@Model.Deposit?.ToString("N0") ?</strong></p>
        <a asp-action="Contract" class="btn btn-outline-primary btn-sm"><i class="fas fa-file-contract me-1"></i>Chi ti?t h?p ??ng</a>
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-paper-plane me-2"></i>G?i thông báo / báo cáo</h5>
        <p class="small text-muted mb-2">B?n có th? g?i ph?n h?i s? c? t?i ch? tr?.</p>
        <a asp-action="SendNotice" class="btn btn-warning btn-sm"><i class="fas fa-exclamation-triangle me-1"></i>G?i thông báo</a>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h5 class="card-title d-flex justify-content-between align-items-center"><span><i class="fas fa-wallet me-2"></i>Hóa ??n</span>@if(Model.OutstandingAmount>0){<form asp-action="PayAll" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm"><i class="fas fa-credit-card me-1"></i>Thanh toán t?t c?</button></form>}</h5>
        @if(Model.UnpaidBills.Any()){
          <div class="table-responsive small">
            <table class="table table-sm table-hover align-middle">
              <thead class="table-light"><tr><th>Mã</th><th>S? ti?n</th><th>Tr?ng thái</th><th></th></tr></thead>
              <tbody>
              @foreach(var b in Model.UnpaidBills){
                <tr>
                  <td>@b.Id.ToString().Substring(0,8)</td>
                  <td>@b.Amount.ToString("N0") ?</td>
                  <td>@b.Status</td>
                  <td class="text-end">
                    <form asp-area="Renter" asp-controller="Bills" asp-action="Pay" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><button class="btn btn-outline-success btn-sm" title="Thanh toán"><i class="fas fa-check"></i></button></form>
                  </td>
                </tr>
              }
              </tbody>
            </table>
          </div>
          <a asp-area="Renter" asp-controller="Bills" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-list me-1"></i>T?t c? hóa ??n</a>
        } else {<div class="alert alert-success p-2 mb-2 small"><i class="fas fa-check-circle me-1"></i>Không còn hóa ??n ch?a thanh toán.</div> <a asp-area="Renter" asp-controller="Bills" asp-action="Index" class="btn btn-outline-secondary btn-sm">Xem l?ch s?</a>}
      </div>
    </div>
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title"><i class="fas fa-info-circle me-2"></i>Thông tin thêm</h5>
        <ul class="small mb-0">
          <li>Giá ?ã bao g?m các d?ch v? c? ??nh (n?u có).</li>
          <li>Hóa ??n t?o m?i tháng b?i ch? tr?, b?n có th? thanh toán tr?c tuy?n.</li>
          <li>Liên h? ch? tr? n?u c?n gia h?n h?p ??ng tr??c ngày h?t h?n.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
