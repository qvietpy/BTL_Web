@model QuanLyPhongTro.src.Models.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Tạo báo cáo";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-circle"></i> Tạo Báo Cáo Sự Cố
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateReport" asp-controller="Renter" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Tiêu đề báo cáo -->
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label fw-bold">
                                <i class="fas fa-heading"></i> Tiêu Đề Báo Cáo
                            </label>
                            <input asp-for="Title" class="form-control"
                                   placeholder="Ví dụ: Máy lạnh không lạnh" required>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Chọn phòng (tuỳ chọn) -->
                        <div class="form-group mb-3">
                            <label asp-for="RoomId" class="form-label fw-bold">
                                <i class="fas fa-door-open"></i> Chọn Phòng (Tuỳ Chọn)
                            </label>
                            <select asp-for="RoomId" class="form-control">
                                <option value="">-- Báo cáo chung --</option>
                                @if (ViewData["Rooms"] is IEnumerable<SelectListItem> rooms)
                                {
                                    @foreach (var room in rooms)
                                    {
                                        <option value="@room.Value">@room.Text</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>

                        <!-- Mô tả chi tiết -->
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-pen-fancy"></i> Mô Tả Chi Tiết
                            </label>
                            <textarea asp-for="Description" class="form-control"
                                      rows="5" placeholder="Vui lòng mô tả chi tiết vấn đề..." required></textarea>
                            <small class="form-text text-muted d-block mt-2">
                                Điền rõ: vấn đề là gì, khi nào bắt đầu, ảnh hưởng như thế nào...
                            </small>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Loại báo cáo (Nếu cần) -->
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-list"></i> Loại Vấn Đề
                            </label>
                            <div class="btn-group-vertical w-100" role="group">
                                <input type="radio" class="btn-check" name="IssueType"
                                       id="issue1" value="Hư hỏng" />
                                <label class="btn btn-outline-primary text-start" for="issue1">
                                    <i class="fas fa-tools"></i> Hư hỏng Thiết Bị/Cơ Sở
                                </label>

                                <input type="radio" class="btn-check" name="IssueType"
                                       id="issue2" value="Vệ sinh" />
                                <label class="btn btn-outline-primary text-start" for="issue2">
                                    <i class="fas fa-broom"></i> Vệ Sinh Khu Vực Chung
                                </label>

                                <input type="radio" class="btn-check" name="IssueType"
                                       id="issue3" value="Ồn ào" />
                                <label class="btn btn-outline-primary text-start" for="issue3">
                                    <i class="fas fa-volume-up"></i> Ồn Ào / Yên Tĩnh
                                </label>

                                <input type="radio" class="btn-check" name="IssueType"
                                       id="issue4" value="An ninh" />
                                <label class="btn btn-outline-primary text-start" for="issue4">
                                    <i class="fas fa-shield-alt"></i> An Ninh / An Toàn
                                </label>

                                <input type="radio" class="btn-check" name="IssueType"
                                       id="issue5" value="Khác" checked />
                                <label class="btn btn-outline-primary text-start" for="issue5">
                                    <i class="fas fa-ellipsis-h"></i> Khác
                                </label>
                            </div>
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="fas fa-paper-plane"></i> Gửi Báo Cáo
                            </button>
                            <a asp-action="Index" asp-controller="Renter" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                        </div>

                        <!-- Ghi chú -->
                        <div class="alert alert-info mt-3 mb-0" role="alert">
                            <i class="fas fa-info-circle"></i>
                            <strong>Lưu ý:</strong> Báo cáo của bạn sẽ được gửi cho quản lý trong vòng 24 giờ.
                            Vui lòng cung cấp thông tin chi tiết để xử lý nhanh chóng.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const title = document.querySelector('[name="Title"]').value.trim();
            const description = document.querySelector('[name="Description"]').value.trim();

            if (title.length < 5) {
                alert('Tiêu đề phải có ít nhất 5 ký tự');
                e.preventDefault();
                return false;
            }

            if (description.length < 20) {
                alert('Mô tả phải có ít nhất 20 ký tự');
                e.preventDefault();
                return false;
            }
        });
    </script>
}

<style>
    .card {
        border: none;
        border-radius: 0.5rem;
    }

    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }

    .btn-group-vertical .btn {
        border-radius: 0.25rem;
        margin-bottom: 0.5rem;
        padding: 0.75rem;
    }

    .form-control, .form-select {
        border-radius: 0.25rem;
        border: 1px solid #dee2e6;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
</style>