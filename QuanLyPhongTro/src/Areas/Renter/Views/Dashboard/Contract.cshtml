@model QuanLyPhongTro.src.Models.ViewModels.ContractDetailViewModel
@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    Layout = "_LayoutRenter";
}

<div class="container py-4">
    <a class="nav-link" asp-area="Renter" asp-controller="Contracts" asp-action="My" class="text-decoration-none mb-3 d-inline-block">
        <i class="fas fa-arrow-left me-1"></i>Quay lại danh sách
    </a>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 text-primary"><i class="fas fa-file-signature me-2"></i>Chi tiết hợp đồng</h4>
                        <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-secondary") fs-6">
                            @Model.Status
                        </span>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <h5 class="fw-bold mb-3">@Model.RoomName</h5>
                    <p class="text-muted mb-4"><i class="fas fa-map-marker-alt me-2 text-danger"></i>@Model.RoomAddress</p>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <div class="p-3 bg-light rounded h-100">
                                <small class="text-muted d-block mb-1">Thời gian thuê</small>
                                <div class="fw-bold">
                                    @Model.Start?.ToString("dd/MM/yyyy") - @Model.End?.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="p-3 bg-light rounded h-100">
                                <small class="text-muted d-block mb-1">Tài chính</small>
                                <div>Giá thuê: <strong>@Model.Price?.ToString("N0") đ</strong></div>
                                <div>Đặt cọc: <strong class="text-danger">@Model.Deposit?.ToString("N0") đ</strong></div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                             <div class="p-3 bg-light rounded h-100">
                                <small class="text-muted d-block mb-1">Diện tích & Người ở</small>
                                <div>Diện tích: <strong>@Model.Area m²</strong></div>
                            </div>
                        </div>
                         <div class="col-md-6 mb-3">
                             <div class="p-3 bg-light rounded h-100">
                                <small class="text-muted d-block mb-1">Chủ trọ</small>
                                <div><i class="fas fa-user me-1"></i> @Model.OwnerName</div>
                                <div><i class="fas fa-phone me-1"></i> @Model.OwnerPhone</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Status == "Active")
                    {
                        <hr class="my-4" />
                        <h5 class="fw-bold mb-3"><i class="fas fa-calendar-plus me-2 text-success"></i>Yêu cầu gia hạn</h5>
                        <div class="bg-light p-3 rounded">
                            <form asp-area="Renter" asp-controller="Contracts" asp-action="RequestExtension" method="post" class="row align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                
                                <div class="col-md-8 mb-2">
    <label class="form-label small text-muted">Số tháng muốn gia hạn thêm</label>
    <input type="number" 
           name="months" 
           class="form-control" 
           min="1" 
           max="36" 
           value="3" 
           placeholder="Nhập vào số tháng muốn gia hạn" 
           required />
    
    <div class="form-text x-small text-muted">Nhập số tháng (từ 1 đến 36)</div>
</div>
                                <div class="col-md-4 mb-2">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-paper-plane me-1"></i>Gửi yêu cầu
                                    </button>
                                </div>
                                <div class="col-12">
                                    <small class="text-muted fst-italic">* Yêu cầu sẽ được gửi đến chủ trọ để phê duyệt.</small>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>