@model IEnumerable<QuanLyPhongTro.src.Models.ViewModels.RoomViewModel>
@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "_LayoutRenter";
    var featured = ViewBag.FeaturedRoom as QuanLyPhongTro.src.Models.ViewModels.RoomViewModel;
    int total = ViewBag.TotalRooms ?? 0;
    int loaded = ViewBag.InitialLoaded ?? Model.Count();
    bool searchMode = ViewBag.SearchMode == true;
    bool emptySearch = ViewBag.EmptySearch == true;
    string keyword = ViewBag.Keyword as string ?? string.Empty;
    decimal? minPrice = ViewBag.MinPrice as decimal?;
    decimal? maxPriceFilter = ViewBag.MaxPriceFilter as decimal?;
    decimal maxPrice = ViewBag.MaxPrice ?? 0m;
    decimal? minArea = ViewBag.MinArea as decimal?;
    decimal? maxArea = ViewBag.MaxArea as decimal?;
}

<style>
    /* CSS để cắt bớt văn bản nếu quá dài */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        min-height: 40px; /* Chiều cao tối thiểu để các card đều nhau */
    }
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Style cho nút yêu thích */
    .fav-btn { background:#fff; border:1px solid #dc3545; color:#dc3545; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:.2s; }
    .fav-btn.inline-fav { position:static; }
    .fav-btn.active { background:#dc3545; color:#fff; }
    .fav-btn:hover { box-shadow:0 0 0 3px rgba(220,53,69,.15); }

    .room-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        transition: box-shadow 0.3s;
        background: #fff;
    }
    .room-card:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    .room-img-wrapper { position: relative; height: 200px; overflow: hidden; }
    .room-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .room-card:hover .room-img { transform: scale(1.05); }
    .room-badge { position: absolute; top: 10px; left: 10px; background: rgba(40, 167, 69, 0.9); color: white; padding: 4px 10px; border-radius: 4px; font-size: 0.8rem; }
    .room-info { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .room-title { font-weight: bold; font-size: 1.1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 85%; }
    .room-price { color: #dc3545; font-weight: bold; font-size: 1.1rem; }
    .room-address { font-size: 0.85rem; color: #666; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

@if (!searchMode && featured != null)
{
    <section class="mb-5">
        <h3 class="fw-bold mb-4 text-primary"><i class="fas fa-star"></i> Phòng mới đăng</h3>
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 position-relative">
                    <a asp-area="Renter" asp-controller="Room" asp-action="Detail" asp-route-id="@featured.Id" class="d-block h-100">
                        <img src="@featured.MainImage" 
                             class="w-100 h-100" 
                             style="object-fit: cover; min-height: 250px; max-height: 350px;" 
                             alt="@featured.Name">
                    </a>
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 shadow-sm px-3 py-2">
                        Mới nhất
                    </span>
                </div>

                <div class="col-md-7 p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3 class="fw-bold mb-0 text-truncate text-dark" style="max-width: 90%;">@featured.Name</h3>
                        <button class="fav-btn inline-fav flex-shrink-0" data-room="@featured.Id" aria-label="Yêu thích">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>

                    <div class="mb-3">
                        <span class="text-danger fw-bold fs-4">@featured.Price.ToString("N0") VND</span>
                        <span class="text-muted small">/tháng</span>
                    </div>
                    
                    <p class="text-muted mb-3 text-truncate">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>@featured.Address
                    </p>
                    
                    <div class="d-flex gap-4 mb-3 text-secondary border-top border-bottom py-2">
                        <span><i class="fas fa-vector-square me-2 text-primary"></i>@featured.Area m²</span>
                        <span><i class="fas fa-user-friends me-2 text-success"></i>Tối đa @featured.MaxOccupants người</span>
                        <span class="d-none d-md-inline"><i class="fas fa-check-circle me-2 text-info"></i>@featured.Status</span>
                    </div>
                    
                    <div class="mb-3 text-muted line-clamp-2" title="@featured.Description">
                        @featured.Description
                    </div>
                    
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Chủ trọ: <strong class="text-dark">@featured.OwnerName</strong>
                        </div>
                        <a asp-area="Renter" asp-controller="Room" asp-action="Detail" asp-route-id="@featured.Id" 
                           class="btn btn-primary px-4 fw-bold shadow-sm">
                            Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section>
    <h3 class="fw-bold mb-4 text-dark">
        @if (searchMode)
        {
            if (emptySearch) { <span>Không có phòng phù hợp với yêu cầu tìm kiếm này</span>; }
            else { <span>Danh sách các phòng phù hợp:</span>; }
        }
        else { <span>Danh sách phòng trọ</span>; }
    </h3>
    
    <div class="row g-4" id="room-grid">
        @foreach (var room in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 room-item">
                <div class="room-card h-100 shadow-sm border-0">
                    <div class="room-img-wrapper">
                        <a asp-area="Renter" asp-controller="Room" asp-action="Detail" asp-route-id="@room.Id">
                            <img src="@room.MainImage" class="room-img" alt="@room.Name">
                        </a>
                        <span class="room-badge"><i class="fas fa-check-circle"></i> @room.Status</span>
                    </div>
                    
                    <div class="room-info d-flex flex-column p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="room-title text-truncate" title="@room.Name" style="max-width: 85%;">@room.Name</div>
                            <button class="fav-btn inline-fav flex-shrink-0" data-room="@room.Id" aria-label="Yêu thích">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                        
                        <div class="room-price mb-2">@room.Price.ToString("N0") VND</div>
                        
                        <div class="d-flex justify-content-between small text-muted mb-2 pb-2 border-bottom">
                            <span><i class="fas fa-vector-square me-1"></i> @room.Area m²</span>
                            <span><i class="fas fa-user-friends me-1"></i> Max: @room.MaxOccupants</span>
                        </div>
                        
                        <div class="room-address mb-2 text-truncate">
                            <i class="fas fa-map-marker-alt me-1 text-danger"></i> @room.Address
                        </div>

                        <div class="small text-muted mb-3 line-clamp-2" title="@room.Description">
                            @room.Description
                        </div>

                        <div class="mt-auto">
                            <div class="small text-muted mb-2">Chủ trọ: <strong>@room.OwnerName</strong></div>
                            <div class="d-grid">
                                <a asp-area="Renter" asp-controller="Room" asp-action="Detail" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary fw-bold">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="text-center mt-5" id="load-more-wrapper">
        @if (!searchMode && loaded < total)
        {
            <button id="btn-load-more" class="btn btn-outline-secondary px-5 py-2 rounded-pill" 
                    data-loaded="@loaded" 
                    data-total="@total" 
                    data-keyword="@keyword" 
                    data-min="@(minPrice ?? 0)" 
                    data-max="@(maxPriceFilter ?? maxPrice)" 
                    data-minarea="@(minArea?.ToString() ?? "")" 
                    data-maxarea="@(maxArea?.ToString() ?? "")">
                Xem thêm phòng
            </button>
        }
    </div>
</section>

@section Scripts {
<script>
(function(){
    async function toggle(btn){
        const roomId = btn.getAttribute('data-room');
        try {
            const res = await fetch('@Url.Action("ToggleFavorite","Room", new { area="Renter" })', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ roomId }) });
            if(!res.ok) throw new Error();
            const data = await res.json();
            if(data.favorited){ btn.classList.add('active'); btn.innerHTML='<i class="fas fa-heart"></i>'; }
            else { btn.classList.remove('active'); btn.innerHTML='<i class="far fa-heart"></i>'; }
        } catch(e){ console.error(e); }
    }
    function wireFavButtons(scope=document){ scope.querySelectorAll('.fav-btn').forEach(b=>{ b.onclick=()=>toggle(b); }); }
    wireFavButtons();
    document.addEventListener('click', function(e){ if(e.target && e.target.id==='btn-load-more'){ setTimeout(()=>wireFavButtons(),500); } });
})();
</script>
}