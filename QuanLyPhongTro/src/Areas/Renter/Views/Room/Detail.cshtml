@model QuanLyPhongTro.src.Models.ViewModels.RoomDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = "_LayoutRenter";
    // Lấy trạng thái đã gửi yêu cầu hay chưa từ Controller
    var hasPendingRequest = ViewBag.HasPendingRequest as bool? ?? false;
}

<style>
    /* CSS Tùy chỉnh */
    .detail-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        border: none;
        margin-bottom: 25px;
    }
    
    .image-gallery img {
        width: 100%;
        height: 450px;
        object-fit: cover;
        border-radius: 12px;
    }

    .price-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }

    .info-item {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 12px;
        height: 100%;
        display: flex;
        align-items: center;
        transition: transform 0.2s;
    }
    .info-item:hover { transform: translateY(-3px); }

    .service-item {
        padding: 12px;
        border-bottom: 1px dashed #e0e0e0;
    }
    .service-item:last-child { border-bottom: none; }

    .fav-btn {
        background: white;
        border: 1px solid #dc3545;
        color: #dc3545;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: .2s;
    }
    .fav-btn.active { background: #dc3545; color: white; }
    .fav-btn:hover { box-shadow: 0 0 0 4px rgba(220,53,69,.15); }
</style>

<div class="container py-4">
    <a href="@Url.Action("Index", "Home", new { area = "Renter" })" class="text-decoration-none text-secondary mb-3 d-inline-block">
        <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
    </a>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="fw-bold mb-0 text-dark">@Model.Name</h2>
                    <button class="fav-btn inline-fav flex-shrink-0" data-room="@Model.Id" title="Lưu tin">
                        <i class="far fa-heart"></i>
                    </button>
                </div>
                
                <p class="text-muted mb-4"><i class="fas fa-map-marker-alt me-2 text-danger"></i>@Model.Address</p>

                <div class="image-gallery mb-4">
                    <div id="roomCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                            {
                                for (int i = 0; i < Model.ImageUrls.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@Model.ImageUrls[i]" class="d-block w-100" alt="Hình @(i+1)" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="carousel-item active">
                                    <img src="/images/no-image.svg" class="d-block w-100" alt="No Image" />
                                </div>
                            }
                        </div>
                        @if (Model.ImageUrls != null && Model.ImageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        }
                    </div>
                </div>

                <h5 class="fw-bold text-secondary text-uppercase fs-6 mb-3">Thông số chi tiết</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="info-item">
                            <i class="fas fa-vector-square text-primary fa-2x me-3"></i>
                            <div>
                                <small class="text-muted d-block">Diện tích</small>
                                <strong>@Model.Area m²</strong>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="info-item">
                            <i class="fas fa-user-friends text-success fa-2x me-3"></i>
                            <div>
                                <small class="text-muted d-block">Sức chứa</small>
                                <strong>@Model.MaxOccupants người</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-item">
                            <i class="fas fa-check-circle text-info fa-2x me-3"></i>
                            <div>
                                <small class="text-muted d-block">Trạng thái</small>
                                <strong>@Model.Status</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold text-secondary text-uppercase fs-6 mb-3">Mô tả</h5>
                <p class="text-justify mb-4" style="white-space: pre-line;">@Model.Description</p>

                <h5 class="fw-bold text-secondary text-uppercase fs-6 mb-3">Dịch vụ & Tiện ích</h5>
                <div class="bg-light rounded p-3">
                    @if (Model.Services != null && Model.Services.Any())
                    {
                        <div class="row">
                            @foreach (var service in Model.Services)
                            {
                                <div class="col-md-6">
                                    <div class="service-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-check text-success me-2"></i>@service.Name</span>
                                        <span class="fw-bold text-primary">@service.PricePerUnit.ToString("N0") đ <small class="text-muted fw-normal">/@service.Unit</small></span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Không có thông tin dịch vụ.</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px; z-index: 100;">
                <div class="price-box mb-4">
                    <h2 class="mb-0 fw-bold">@Model.Price.ToString("N0") đ</h2>
                    <div class="opacity-75">/ tháng</div>
                </div>

                <div class="detail-card pt-4">
                    <h6 class="fw-bold mb-3 border-bottom pb-2">Thông tin chủ nhà</h6>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light rounded-circle p-3 me-3 text-primary">
                            <i class="fas fa-user fa-lg"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">@Model.OwnerName</h6>
                            <small class="text-muted">Chủ trọ</small>
                        </div>
                    </div>
                    <p class="mb-2 small"><i class="fas fa-phone me-2 text-muted"></i>@Model.OwnerPhone</p>
                    <p class="mb-4 small"><i class="fas fa-envelope me-2 text-muted"></i>@Model.OwnerEmail</p>

                    <hr />

                    @if (hasPendingRequest)
                    {
                        <div class="text-center py-3">
                            <div class="fs-1 text-warning mb-2"><i class="fas fa-clock"></i></div>
                            <h5 class="fw-bold text-warning">Yêu cầu đang xử lý</h5>
                            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 small mt-3">
                                Bạn đã gửi yêu cầu thuê phòng này.<br />
                                Vui lòng chờ chủ trọ phản hồi.
                            </div>
                            <button class="btn btn-secondary w-100 mt-2" disabled>Đã gửi yêu cầu</button>
                        </div>
                    }
                    else
                    {
                        <h5 class="fw-bold mb-3"><i class="fas fa-paper-plane me-2 text-primary"></i>Gửi yêu cầu thuê</h5>
                        
                        <form asp-area="Renter" asp-controller="Room" asp-action="RequestRental" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RoomId" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Ngày bắt đầu</label>
                                <input type="date" name="StartDate" class="form-control"
                                       value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Ngày kết thúc</label>
                                <input type="date" name="EndDate" class="form-control"
                                       value="@DateTime.Now.AddMonths(6).ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Tiền đặt cọc (VNĐ)</label>
                                <input type="number" name="Deposit" class="form-control"
                                       value="@((Model.Price * 1).ToString("0"))" required />
                                <div class="form-text x-small">Khuyến nghị: 1 tháng tiền phòng</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Ghi chú</label>
                                <textarea name="Note" class="form-control" rows="3" placeholder="Lời nhắn gửi chủ trọ..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                                Gửi yêu cầu ngay
                            </button>
                        </form>
                        <div class="text-center mt-3">
                            <small class="text-muted fst-italic">Yêu cầu sẽ được gửi đến chủ nhà duyệt</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Script xử lý nút yêu thích
    (function(){
        async function toggle(btn){
            const roomId = btn.getAttribute('data-room');
            try {
                const res = await fetch('@Url.Action("ToggleFavorite","Room", new { area="Renter" })', { 
                    method:'POST', 
                    headers:{'Content-Type':'application/json'}, 
                    body: JSON.stringify({ roomId }) 
                });
                
                if(!res.ok) throw new Error();
                
                const data = await res.json();
                if(data.favorited){ 
                    btn.classList.add('active'); 
                    btn.innerHTML='<i class="fas fa-heart"></i>'; 
                } else { 
                    btn.classList.remove('active'); 
                    btn.innerHTML='<i class="far fa-heart"></i>'; 
                }
            } catch(e){ console.error(e); }
        }
        
        const btn = document.querySelector('.fav-btn.inline-fav');
        if(btn) btn.onclick = () => toggle(btn);
    })();
</script>
}