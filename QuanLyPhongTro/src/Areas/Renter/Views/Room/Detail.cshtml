@model QuanLyPhongTro.src.Models.ViewModels.RoomDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = "_LayoutRenter";
    // Check if current user has pending booking request for this room
    var hasPendingRequest = ViewBag.HasPendingRequest as bool? ?? false;
}
<div class="row">
    <div class="col-lg-7">
        <div id="carouselRoom" class="carousel slide mb-3" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.ImageUrls.Count; i++)
                {
                    var img = Model.ImageUrls[i];
                    <div class="carousel-item @(i==0?"active":"")">
                        <img src="@img" class="d-block w-100" alt="@Model.Name">
                    </div>
                }
                @if (Model.ImageUrls.Count == 0)
                {
                    <div class="carousel-item active">
                        <img src="/images/no-image.svg" class="d-block w-100" alt="@Model.Name">
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselRoom" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselRoom" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
    <div class="col-lg-5">
        <h2 class="d-flex justify-content-between align-items-center">
            <span>@Model.Name</span>
            <button class="fav-btn inline-fav" data-room="@Model.Id"><i class="far fa-heart"></i></button>
        </h2>
        <div class="text-danger fs-5 fw-semibold mb-2">@Model.Price.ToString("N0") VND/tháng</div>
        <div class="text-muted mb-2"><i class="fas fa-map-marker-alt me-1 text-danger"></i>@Model.Address</div>
        <div class="mb-2"><i class="fas fa-vector-square me-1"></i>@Model.Area m²</div>
        <div class="mb-3">@Model.Description</div>
        <div class="card mb-3">
            <div class="card-body">
                <div class="fw-semibold mb-1">Chủ trọ</div>
                <div>Tên: @Model.OwnerName</div>
                <div>Điện thoại: <a href="tel:@Model.OwnerPhone">@Model.OwnerPhone</a></div>
                <div>Email: <a href="mailto:@Model.OwnerEmail">@Model.OwnerEmail</a></div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                @if (hasPendingRequest)
                {
                    <div class="text-center">
                        <div class="fw-semibold mb-2 text-warning">
                            <i class="fas fa-clock me-2"></i>Yêu cầu đang xử lý
                        </div>
                        <div class="alert alert-warning mb-0">
                            <div class="mb-2">Bạn đã gửi yêu cầu thuê phòng này.</div>
                            <div class="small">Vui lòng chờ chủ trọ xác nhận hoặc từ chối yêu cầu của bạn.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="fw-semibold mb-2">Đặt phòng</div>
                    <form asp-action="CreateBooking" asp-controller="Room" asp-area="Renter" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="roomId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-6">
                                <label class="form-label">Ngày bắt đầu</label>
                                <input type="date" name="desiredStartDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-3">
                                <label class="form-label">Tháng</label>
                                <input type="number" name="desiredDurationMonths" class="form-control" value="6" min="1" max="24" required />
                            </div>
                            <div class="col-12 mt-2">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" name="note" rows="2" placeholder="Yêu cầu thêm (nếu có)"></textarea>
                            </div>
                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary w-100">Gửi yêu cầu đặt phòng</button>
                            </div>
                        </div>
                    </form>
                }
                @if(TempData["SuccessMessage"]!=null){<div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>}
                @if(TempData["InfoMessage"]!=null){<div class="alert alert-info mt-3">@TempData["InfoMessage"]</div>}
                @if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>}
            </div>
        </div>
    </div>
</div>
@section Scripts{
<script>
 (function(){
   const btn=document.querySelector('.fav-btn.inline-fav');
   if(btn){ btn.addEventListener('click', async ()=>{
     const roomId=btn.getAttribute('data-room');
     try{ const res=await fetch('@Url.Action("ToggleFavorite","Room", new { area = "Renter" })',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({roomId})}); if(!res.ok) throw 0; const data=await res.json(); if(data.favorited){ btn.classList.add('active'); btn.innerHTML='<i class="fas fa-heart"></i>'; } else { btn.classList.remove('active'); btn.innerHTML='<i class="far fa-heart"></i>'; } window.dispatchEvent(new CustomEvent('favorites-changed')); }catch(e){console.error(e);}  }); }
 })();
</script>
}
