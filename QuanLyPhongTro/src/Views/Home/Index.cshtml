@{
    ViewData["Title"] = "Trang chủ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 30px;
        }

        .dashboard-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .user-info {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="user-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-home me-2"></i>Xin chào, @ViewBag.FullName!</h2>
                    <p class="mb-0">
                        <i class="fas fa-user me-2"></i>Username: @ViewBag.Username |
                        <i class="fas fa-user-tag me-2"></i>Vai trò: @ViewBag.Role
                    </p>
                </div>
                <div>
                    <a href="@Url.Action("Logout", "Auth")" class="btn btn-light">
                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="dashboard-card">
            <h3 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="card text-center border-primary">
                        <div class="card-body">
                            <i class="fas fa-building fa-3x text-primary mb-3"></i>
                            <h5>Quản lý Phòng</h5>
                            <p class="text-muted">Xem và quản lý phòng trọ</p>
                            <button class="btn btn-primary">Xem chi tiết</button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card text-center border-success">
                        <div class="card-body">
                            <i class="fas fa-file-invoice fa-3x text-success mb-3"></i>
                            <h5>Hóa đơn</h5>
                            <p class="text-muted">Quản lý hóa đơn thanh toán</p>
                            <button class="btn btn-success">Xem chi tiết</button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card text-center border-warning">
                        <div class="card-body">
                            <i class="fas fa-file-contract fa-3x text-warning mb-3"></i>
                            <h5>Hợp đồng</h5>
                            <p class="text-muted">Quản lý hợp đồng thuê</p>
                            <button class="btn btn-warning">Xem chi tiết</button>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="alert alert-info">
                <h5><i class="fas fa-info-circle me-2"></i>Thông tin hệ thống</h5>
                <ul class="mb-0">
                    <li>Bạn đã đăng nhập thành công vào hệ thống Quản lý Phòng Trọ</li>
                    <li>Vai trò của bạn: <strong>@ViewBag.Role</strong></li>
                    <li>Hệ thống đang hoạt động bình thường</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>