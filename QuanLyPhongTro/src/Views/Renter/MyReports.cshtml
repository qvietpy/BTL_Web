@model IEnumerable<QuanLyPhongTro.src.Models.ViewModels.ReportViewModel>
@{
    ViewData["Title"] = "Báo cáo của tôi";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-flag me-2"></i>Báo cáo của tôi</h2>
        <a href="#" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Tạo báo cáo mới</a>
    </div>
    @if (Model.Any())
    {
        foreach (var report in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@report.Title</h5>
                    <p class="card-text">@report.Description</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">Bạn chưa có báo cáo nào.</div>
    }
</div>