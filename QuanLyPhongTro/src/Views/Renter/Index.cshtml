@model IEnumerable<QuanLyPhongTro.src.Models.ViewModels.RoomListViewModel>
@{
    ViewData["Title"] = "Trang chủ Renter";
    Layout = null; // disable layout, full HTML provided in this view
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; }
        .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .hero-section { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 60px 0; margin-bottom: 40px; }
        .room-card { background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.1); transition: transform 0.3s; margin-bottom: 30px; }
        .room-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.15); }
        .room-image { height: 200px; object-fit: cover; width: 100%; }
        .price-tag { background: #ff6b6b; color: white; padding: 5px 15px; border-radius: 20px; font-weight: bold; }
        .feature-icon { width: 80px; height: 80px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 30px; margin: 0 auto 15px; }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Login","Auth", new { area="Renter" })">
                <i class="fas fa-home me-2"></i>Quản lý Phòng Trọ
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link active" href="#"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home", new { area="Renter" })"><i class="fas fa-search me-1"></i>Tìm phòng</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Renter/Contracts/My"><i class="fas fa-file-contract me-1"></i>Hợp đồng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("SendNotice","Dashboard", new { area="Renter" })"><i class="fas fa-flag me-1"></i>Báo cáo</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown"><i class="fas fa-user me-1"></i>@ViewBag.FullName</a>
                        <ul class="dropdown-menu">
                            <li>
                                <form asp-area="Renter" asp-controller="Auth" asp-action="Logout" method="post" class="px-3">@Html.AntiForgeryToken()<button type="submit" class="btn btn-link dropdown-item p-0"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</button></form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 mb-3">Chào mừng đến với hệ thống tìm phòng trọ!</h1>
            <p class="lead mb-4">Tìm kiếm phòng trọ phù hợp với nhu cầu của bạn</p>
            <a href="@Url.Action("Index","Home", new { area="Renter" })" class="btn btn-light btn-lg"><i class="fas fa-search me-2"></i>Tìm phòng ngay</a>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null){<div class="container"><div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div></div>}
    <div class="container mb-5">
        <div class="row text-center">
            <div class="col-md-4 mb-4"><div class="feature-icon"><i class="fas fa-search"></i></div><h5>Tìm kiếm dễ dàng</h5><p class="text-muted">Hệ thống lọc thông minh giúp bạn tìm phòng phù hợp</p></div>
            <div class="col-md-4 mb-4"><div class="feature-icon"><i class="fas fa-shield-alt"></i></div><h5>An toàn & Tin cậy</h5><p class="text-muted">Thông tin được xác minh, giao dịch minh bạch</p></div>
            <div class="col-md-4 mb-4"><div class="feature-icon"><i class="fas fa-headset"></i></div><h5>Hỗ trợ 24/7</h5><p class="text-muted">Đội ngũ hỗ trợ luôn sẵn sàng</p></div>
        </div>
    </div>
    <div class="container mb-5">
        <h2 class="mb-4"><i class="fas fa-star text-warning me-2"></i>Phòng trọ nổi bật</h2>
        @if (Model.Any()){
            <div class="row">
            @foreach (var room in Model){<div class="col-md-4"><div class="room-card"><img src="@(room.ImageUrls.FirstOrDefault() ?? "https://via.placeholder.com/400x200?text=No+Image")" alt="@room.Name" class="room-image" /><div class="p-3"><h5 class="mb-2">@room.Name</h5><p class="text-muted mb-2"><i class="fas fa-map-marker-alt me-1"></i>@room.Address</p><div class="d-flex justify-content-between align-items-center mb-3"><span><i class="fas fa-expand-arrows-alt me-1"></i>@room.Area m²</span><span><i class="fas fa-users me-1"></i>@room.MaxOccupants người</span></div><div class="d-flex justify-content-between align-items-center"><span class="price-tag">@room.Price.ToString("N0") đ/tháng</span><a href="/Renter/Room/Detail/@room.Id" class="btn btn-sm btn-primary"><i class="fas fa-info-circle me-1"></i>Chi tiết</a></div></div></div></div>}
            </div>
            <div class="text-center mt-4"><a href="@Url.Action("Index","Home", new { area="Renter" })" class="btn btn-primary btn-lg">Xem tất cả phòng <i class="fas fa-arrow-right ms-2"></i></a></div>
        } else {<div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>Hiện chưa có phòng trống nào.</div>}
    </div>
    <footer class="bg-dark text-white text-center py-4 mt-5"><p class="mb-0">&copy; 2025 Quản lý Phòng Trọ. All rights reserved.</p></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>