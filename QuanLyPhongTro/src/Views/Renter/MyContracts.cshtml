@model IEnumerable<QuanLyPhongTro.src.Models.ViewModels.RenterContractViewModel>
@{
    ViewData["Title"] = "Hợp đồng của tôi";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f5f5f5;
        }

        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .contract-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            transition: transform 0.3s;
        }

            .contract-card:hover {
                transform: translateY(-3px);
            }

        .status-badge {
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
        }

        .status-pending {
            background: #ffc107;
            color: #000;
        }

        .status-active {
            background: #28a745;
            color: white;
        }

        .status-expired {
            background: #dc3545;
            color: white;
        }

        .status-cancelled {
            background: #6c757d;
            color: white;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Renter")">
                <i class="fas fa-home me-2"></i>Quản lý Phòng Trọ
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Renter")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Rooms", "Renter")">Tìm phòng</a></li>
                    <li class="nav-item"><a class="nav-link active" href="@Url.Action("MyContracts", "Renter")">Hợp đồng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MyReports", "Renter")">Báo cáo</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Logout", "Auth")">Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="mb-4"><i class="fas fa-file-contract me-2"></i>Hợp đồng của tôi</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Any())
        {
            <div class="row">
                @foreach (var contract in Model)
                {
                    var statusClass = contract.Status switch
                    {
                        "Pending" => "status-pending",
                        "Active" => "status-active",
                        "Expired" => "status-expired",
                        _ => "status-cancelled"
                    };

                    var statusText = contract.Status switch
                    {
                        "Pending" => "Chờ duyệt",
                        "Active" => "Đang hiệu lực",
                        "Expired" => "Hết hạn",
                        _ => "Đã hủy"
                    };

                    <div class="col-md-6">
                        <div class="contract-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="mb-0">@contract.RoomName</h5>
                                <span class="status-badge @statusClass">
                                    <i class="fas fa-circle me-1"></i>@statusText
                                </span>
                            </div>

                            <p class="text-muted mb-3">
                                <i class="fas fa-map-marker-alt me-2"></i>@contract.RoomAddress
                            </p>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Ngày bắt đầu</small>
                                    <p class="mb-0"><strong>@contract.StartDate.ToString("dd/MM/yyyy")</strong></p>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Ngày kết thúc</small>
                                    <p class="mb-0"><strong>@contract.EndDate.ToString("dd/MM/yyyy")</strong></p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted">Tiền đặt cọc</small>
                                    <p class="mb-0 text-danger">
                                        <strong>@contract.Deposit.ToString("N0") đ</strong>
                                    </p>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Thời hạn</small>
                                    <p class="mb-0">
                                        <strong>@((contract.EndDate - contract.StartDate).Days / 30) tháng</strong>
                                    </p>
                                </div>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <small class="text-muted d-block mb-2">Thông tin chủ nhà</small>
                                <p class="mb-1"><i class="fas fa-user me-2"></i>@contract.OwnerName</p>
                                <p class="mb-0"><i class="fas fa-phone me-2"></i>@contract.OwnerPhone</p>
                            </div>

                            <div class="d-flex gap-2">
                                @if (contract.Status == "Active")
                                {
                                    <button class="btn btn-primary btn-sm flex-fill">
                                        <i class="fas fa-eye me-1"></i>Xem chi tiết
                                    </button>
                                    <a href="@Url.Action("CreateReport", "Renter")" class="btn btn-warning btn-sm flex-fill">
                                        <i class="fas fa-exclamation-triangle me-1"></i>Báo cáo
                                    </a>
                                }
                                else if (contract.Status == "Pending")
                                {
                                    <button class="btn btn-secondary btn-sm flex-fill" disabled>
                                        <i class="fas fa-clock me-1"></i>Đang chờ duyệt
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm flex-fill">
                                        <i class="fas fa-history me-1"></i>Lịch sử
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2 fa-2x"></i>
                <h5>Bạn chưa có hợp đồng nào</h5>
                <p class="mb-3">Hãy tìm kiếm và gửi yêu cầu thuê phòng để bắt đầu!</p>
                <a href="@Url.Action("Rooms", "Renter")" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Tìm phòng ngay
                </a>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>