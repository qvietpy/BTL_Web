@model QuanLyPhongTro.src.Models.ViewModels.RoomSearchViewModel
@{
    ViewData["Title"] = "Tìm kiếm phòng trọ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; }
        .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .search-panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }
        .room-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s;
            margin-bottom: 25px;
            height: 100%;
        }
        .room-card:hover { transform: translateY(-5px); }
        .room-image {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }
        .price-tag {
            background: #ff6b6b;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 18px;
        }
        .pagination { margin-top: 30px; }
        .page-link {
            color: #667eea;
            border-radius: 10px;
            margin: 0 3px;
        }
        .page-link:hover { background: #667eea; color: white; }
        .page-item.active .page-link {
            background: #667eea;
            border-color: #667eea;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Renter")">
                <i class="fas fa-home me-2"></i>Quản lý Phòng Trọ
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Renter")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link active" href="@Url.Action("Rooms", "Renter")">Tìm phòng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MyContracts", "Renter")">Hợp đồng</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("MyReports", "Renter")">Báo cáo</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Logout", "Auth")">Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2 class="mb-4"><i class="fas fa-search me-2"></i>Tìm kiếm phòng trọ</h2>

        <!-- Bộ lọc -->
<div class="search-panel">
    <form method="get" asp-action="Rooms">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label"><i class="fas fa-keyboard me-1"></i>Từ khóa</label>
                <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên phòng, mô tả..." />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label"><i class="fas fa-map-marker-alt me-1"></i>Địa chỉ</label>
                <input name="address" value="@Model.Address" class="form-control" placeholder="Quận, đường..." />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label"><i class="fas fa-users me-1"></i>Số người tối đa</label>
                <select name="maxOccupants" class="form-select">
                    <option value="">-- Tất cả --</option>
                    @if (Model.MaxOccupants == 1)
                    {
                        <option value="1" selected>1 người</option>
                    }
                    else
                    {
                        <option value="1">1 người</option>
                    }

                    @if (Model.MaxOccupants == 2)
                    {
                        <option value="2" selected>2 người</option>
                    }
                    else
                    {
                        <option value="2">2 người</option>
                    }

                    @if (Model.MaxOccupants == 3)
                    {
                        <option value="3" selected>3 người</option>
                    }
                    else
                    {
                        <option value="3">3 người</option>
                    }

                    @if (Model.MaxOccupants >= 4)
                    {
                        <option value="4" selected>4+ người</option>
                    }
                    else
                    {
                        <option value="4">4+ người</option>
                    }
                </select>
            </div>
        </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-dollar-sign me-1"></i>Giá từ (VNĐ)</label>
                        <input name="minPrice" value="@Model.MinPrice" type="number" class="form-control" placeholder="1.000.000" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-dollar-sign me-1"></i>Giá đến (VNĐ)</label>
                        <input name="maxPrice" value="@Model.MaxPrice" type="number" class="form-control" placeholder="5.000.000" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-expand-arrows-alt me-1"></i>Diện tích từ (m²)</label>
                        <input name="minArea" value="@Model.MinArea" type="number" class="form-control" placeholder="15" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label"><i class="fas fa-expand-arrows-alt me-1"></i>Diện tích đến (m²)</label>
                        <input name="maxArea" value="@Model.MaxArea" type="number" class="form-control" placeholder="30" />
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="fas fa-search me-2"></i>Tìm kiếm
                    </button>
                    <a href="@Url.Action("Rooms", "Renter")" class="btn btn-secondary btn-lg px-5 ms-2">
                        <i class="fas fa-redo me-2"></i>Làm mới
                    </a>
                </div>
            </form>
        </div>

        <!-- Kết quả -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Tìm thấy @Model.TotalRooms phòng</h4>
            <span class="text-muted">Trang @Model.CurrentPage / @Model.TotalPages</span>
        </div>
        
        @if (Model.Results.Any())
        {
            <div class="row">
                @foreach (var room in Model.Results)
                {
                    <div class="col-md-4">
                        <div class="room-card">
                            <img src="@(room.ImageUrls.FirstOrDefault() ?? "https://via.placeholder.com/400x250?text=No+Image")" 
                                 alt="@room.Name" class="room-image" />
                            <div class="p-3">
                                <h5 class="mb-2">@room.Name</h5>
                                <p class="text-muted mb-2">
                                    <i class="fas fa-map-marker-alt me-1 text-danger"></i>@room.Address
                                </p>
                                <p class="mb-2 text-secondary" style="font-size: 14px;">
                                    @(room.Description.Length > 80 ? room.Description.Substring(0, 80) + "..." : room.Description)
                                </p>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <small class="text-muted">
                                            <i class="fas fa-expand-arrows-alt me-1"></i>@room.Area m²
                                        </small>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">
                                            <i class="fas fa-users me-1"></i>@room.MaxOccupants người
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="price-tag">@room.Price.ToString("N0") đ</span>
                                    <a href="@Url.Action("RoomDetail", "Renter", new { id = room.Id })" 
                                       class="btn btn-primary">
                                        <i class="fas fa-info-circle me-1"></i>Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Phân trang -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <!-- Previous -->
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Rooms", new { 
                                keyword = Model.Keyword,
                                address = Model.Address,
                                minPrice = Model.MinPrice,
                                maxPrice = Model.MaxPrice,
                                minArea = Model.MinArea,
                                maxArea = Model.MaxArea,
                                maxOccupants = Model.MaxOccupants,
                                page = Model.CurrentPage - 1 
                            })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        <!-- Page numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Rooms", new { 
                                    keyword = Model.Keyword,
                                    address = Model.Address,
                                    minPrice = Model.MinPrice,
                                    maxPrice = Model.MaxPrice,
                                    minArea = Model.MinArea,
                                    maxArea = Model.MaxArea,
                                    maxOccupants = Model.MaxOccupants,
                                    page = i 
                                })">@i</a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Rooms", new { 
                                keyword = Model.Keyword,
                                address = Model.Address,
                                minPrice = Model.MinPrice,
                                maxPrice = Model.MaxPrice,
                                minArea = Model.MinArea,
                                maxArea = Model.MaxArea,
                                maxOccupants = Model.MaxOccupants,
                                page = Model.CurrentPage + 1 
                            })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>Không tìm thấy phòng nào phù hợp. Vui lòng thử lại với điều kiện khác.
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>